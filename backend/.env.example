# ==============================================
# Healthy Harvest API - Environment Variables
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file.
# ==============================================

# --- App ---
APP_NAME="Healthy Harvest API"
APP_ENV=development
DEBUG=true

# --- CORS ---
# Comma separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
# Configuration only in Phase 1 - no tables/migrations are applied yet.
POSTGRES_USER=healthy_harvest
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=healthy_harvest_db

# Optional: if set, this overrides the individual POSTGRES_* fields above
DATABASE_URL=

# --- Razorpay payments (Phase 7) ---
# Use Razorpay TEST MODE while developing: Dashboard -> switch to "Test Mode"
# -> Account & Settings -> API Keys -> Generate Test Key. Test keys start with
# "rzp_test_" and never move real money. The app refuses to start with a
# "rzp_live_" key unless APP_ENV=production.
#
# RAZORPAY_KEY_ID is public (the browser needs it to open Razorpay Checkout).
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET are server-only: never
# commit them, never put them in the frontend, never paste them in chat.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Account & Settings -> Webhooks -> Add webhook. Pick any secret
# you like, enter it there AND here. URL: <public https URL>/api/payments/webhook
# (for local testing use a tunnel such as ngrok). Events: payment.authorized,
# payment.captured, payment.failed, order.paid.
RAZORPAY_WEBHOOK_SECRET=

# An unpaid order keeps its reserved stock this long, then expires.
ORDER_PAYMENT_WINDOW_MINUTES=30
# The expiry job that releases stock/coupons of unpaid orders. It runs inside
# the web server; set the first to false if you run
# `python -m app.jobs.expire_orders` from cron instead.
ORDER_EXPIRY_WORKER_ENABLED=true
ORDER_EXPIRY_INTERVAL_SECONDS=60
ORDER_EXPIRY_BATCH_SIZE=50


# --- Invoice PDF (Phase 8) ---
# Seller details printed on downloadable invoices. All optional; anything left
# blank is simply not printed, and nothing is invented. Fill these in with real,
# legally correct details before you give invoices to customers.
INVOICE_SELLER_NAME=
# One line; use " | " where a line break is wanted.
INVOICE_SELLER_ADDRESS=
# 15-character GSTIN (format is checked at startup), or leave empty.
INVOICE_SELLER_GSTIN=
INVOICE_SELLER_EMAIL=
