# ==============================================
# Pramanika API - Environment Variables
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file.
# ==============================================

# --- App ---
APP_NAME="Pramanika API"
APP_ENV=development
DEBUG=true

# --- CORS ---
# Comma separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
# Configuration only in Phase 1 - no tables/migrations are applied yet.
POSTGRES_USER=healthy_harvest
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=healthy_harvest_db

# Optional: if set, this overrides the individual POSTGRES_* fields above
DATABASE_URL=
